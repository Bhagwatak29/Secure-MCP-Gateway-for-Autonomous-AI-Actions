# Copy this file to .env and fill in your values. Never commit .env itself.

# GitHub Personal Access Token.
# Fine-grained token: grant "Issues" read/write on the specific repos you need.
# Classic token: needs the "repo" scope (or "public_repo" for public repos only).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: restrict the server to specific repos ("owner/repo", comma-separated).
# Leave blank to allow any repo the token can access.
ALLOWED_REPOS=your-org/your-repo

# Optional: where the metrics SQLite DB is written.
METRICS_DB_PATH=metrics.db
